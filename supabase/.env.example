APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174
DEV_CREDIT_EMAIL_ALLOWLIST=tester@example.com

# Server-only OpenAI settings for analyze-document. Set real values with
# `supabase secrets set --project-ref ...`; never expose them to the browser.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Supabase provides these automatically in hosted Edge Functions and local CLI.
# Never commit their values:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
